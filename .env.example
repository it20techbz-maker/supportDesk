# Copy to .env and fill in. Never commit real values.
# On Vercel, set these under Project > Settings > Environment Variables instead.

# Supabase connection string (Connect > Transaction pooler, port 6543).
# Leave empty to use a local SQLite file.
DATABASE_URL=

# Sign-in for the console. Required on Vercel.
CONSOLE_USER=admin
CONSOLE_PASSWORD=

# Mailbox that receives "please investigate" emails
SUPPORT_EMAIL=

# Leave false until the company has approved sending masked customer text to an AI service
AI_ENABLED=false
ANTHROPIC_API_KEY=

# WhatsApp: "fake" records messages only, "baileys" sends through whatsapp-bridge/
WHATSAPP_MODE=fake
BRIDGE_URL=http://127.0.0.1:8766
BRIDGE_TOKEN=

# Optional overrides for running locally
DB_PATH=
CUSTOMERS_FILE=
KNOWLEDGE_DIR=
